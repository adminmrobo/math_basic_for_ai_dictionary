   "definition": {
    "ko": "다른 변수는 상수로 고정하고 변수 하나에 대해서만 미분한 변화율. ∂f/∂x 또는 fₓ."
   }
  },
  {
   "id": "lab:concept/m12-example",
   "type": "Concept",
   "label": {
    "ko": "편미분 계산 예",
    "en": "Example: Finding Partial Derivatives"
   },
   "page": "12_gradient",
   "anchor": "#m12-example",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "f(x, y) = x²y + 3xy + y² → ∂f/∂x = 2xy + 3y, ∂f/∂y = x² + 3x + 2y."
   }
  },
  {
