   }
  },
  {
   "id": "lab:concept/m12-table",
   "type": "Concept",
   "label": {
    "ko": "자주 쓰는 함수의 그래디언트",
    "en": "Common Functions and Their Gradients"
   },
   "page": "12_gradient",
   "anchor": "#m12-table",
