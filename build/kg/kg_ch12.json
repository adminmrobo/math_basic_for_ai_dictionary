   "match": [],
   "definition": {
    "ko": "x² + y² → (2x, 2y), xy → (y, x), sin x + cos y → (cos x, −sin y), eˣʸ → (yeˣʸ, xeˣʸ), ln(x² + y²) → (2x/(x² + y²), 2y/(x² + y²))."
   }
  },
  {
   "id": "lab:sim/ch12-lab",
   "type": "Simulation",
   "label": {
