    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "시그모이드 1/(1+e⁻ˣ), tanh (eˣ − e⁻ˣ)/(eˣ + e⁻ˣ), ReLU max(0, x), MSE (1/m)Σ(yᵢ − ŷᵢ)², 교차 엔트로피 −(1/m)Σ[y log ŷ + (1−y) log(1−ŷ)], 소프트맥스 e^zᵢ / Σe^zⱼ."
   }
  },
  {
   "id": "lab:concept/m15-practical",
   "type": "Concept",
   "label": {
    "ko": "실전 예제 세 개",
    "en": "Practical Examples"
   },
   "page": "15_quick_revision",
   "anchor": "#m15-practical",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "① 경사하강 한 걸음: (1, 2) → (0.8, 1.6). ② 2 × 2 고윳값: [[2, 1], [1, 2]] → λ = 3, 1. ③ 간단한 PCA: X = [[2, 0], [0, 1], [1, 1]]."
   }
  },
  {
   "id": "lab:concept/m15-takeaways",
   "type": "Concept",
   "label": {
    "ko": "핵심 정리",
    "en": "Key Takeaways"
   },
