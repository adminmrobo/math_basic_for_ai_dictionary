   }
  },
  {
   "id": "lab:sim/ch10-lab",
   "type": "Simulation",
   "label": {
    "ko": "점 구름 실험실",
    "en": "Interactive lab ch10"
   },
   "page": "10_correlation",
   "anchor": "#lab",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "상관계수는 \"직선으로 얼마나 함께 가는가\"만 재는 자입니다. 곡선 관계, 튀는 점, 숨은 원인은 이 자로 보이지 않아요. 그래서 r은 늘 산점도와 한 쌍으로 읽고, 높은 r을 보면 \"왜 함께 움직일까?\"를 꼭 물어야 합니다."
   }
  },
  {
   "id": "lab:analogy/ch10-toon1",
   "type": "Analogy",
   "label": {
    "ko": "아이스크림과 상어",
    "en": "Cartoon 1"
   },
