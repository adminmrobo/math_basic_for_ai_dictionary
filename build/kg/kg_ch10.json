 "nodes": [
  {
   "id": "lab:concept/m10-cov",
   "type": "Concept",
   "label": {
    "ko": "공분산이란",
    "en": "What is Covariance"
   },
   "page": "10_correlation",
   "anchor": "#m10-cov",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "두 변수가 같은 방향으로 움직이는지(+) 반대로 움직이는지(−) 알려 주는 값. Cov = Σ(xᵢ − x̄)(yᵢ − ȳ) / n."
   }
  },
  {
   "id": "lab:concept/m10-interp",
   "type": "Concept",
   "label": {
    "ko": "공분산 읽기",
    "en": "Interpretation of Covariance"
   },
   "page": "10_correlation",
   "anchor": "#m10-interp",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "Cov > 0 함께 증가, Cov < 0 하나가 늘면 다른 하나가 줆, Cov = 0 직선 관계 없음."
   }
  },
  {
   "id": "lab:concept/m10-covex",
   "type": "Concept",
   "label": {
    "ko": "공분산 계산 예",
    "en": "Example: Covariance Calculation"
   },
   "page": "10_correlation",
   "anchor": "#m10-covex",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "X = 1, 2, 3, 4, 5, Y = 2, 4, 5, 4, 5 → Cov = 6/5 = 1.2 (양의 관계)."
   }
  },
  {
   "id": "lab:concept/m10-corr",
   "type": "Concept",
   "label": {
    "ko": "상관계수란",
    "en": "What is Correlation"
   },
   "page": "10_correlation",
   "anchor": "#m10-corr",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "두 변수의 직선 관계의 세기와 방향. r = Cov(X, Y) / (σX σY), 늘 −1 ≤ r ≤ 1."
   }
  },
  {
   "id": "lab:concept/m10-correx",
   "type": "Concept",
   "label": {
    "ko": "상관계수 계산 예",
    "en": "Example: Correlation Calculation"
   },
   "page": "10_correlation",
   "anchor": "#m10-correx",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "같은 5점에서 σX = √2 ≈ 1.414, σY = √1.2 ≈ 1.095 → r = 1.2 / 1.549 ≈ 0.775."
   }
  },
  {
   "id": "lab:concept/m10-scatter",
   "type": "Concept",
   "label": {
    "ko": "산점도와 상관",
    "en": "Scatter Plots and Correlation"
   },
   "page": "10_correlation",
   "anchor": "#m10-scatter",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "점 구름의 모양으로 상관을 눈으로 본다: 강한 양(r ≈ 1), 강한 음(r ≈ −1), 없음(r ≈ 0), 약한 양(r > 0)."
   }
  },
  {
   "id": "lab:concept/m10-vs",
   "type": "Concept",
   "label": {
    "ko": "공분산 vs 상관",
    "en": "Covariance vs Correlation"
   },
   "page": "10_correlation",
   "anchor": "#m10-vs",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "공분산: 방향만, 범위 −∞~+∞, 단위에 따라 바뀜. 상관: 방향과 세기, −1~+1, 단위 없음."
   }
  },
  {
   "id": "lab:concept/m10-ml",
