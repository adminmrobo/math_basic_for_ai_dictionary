   ],
   "match": [],
   "definition": {
    "ko": "쉬운 문제 60%, 어려운 문제 30%를 맞히는 학생. 어려운 문제가 주어지면 맞힐 확률 = P(S|H) = 0.3."
   }
  },
  {
   "id": "lab:concept/m07-bayes",
   "type": "Concept",
   "label": {
    "ko": "베이즈 정리",
    "en": "Bayes' Theorem"
   },
   "page": "07_bayes",
   "anchor": "#m07-bayes",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
