   }
  },
  {
   "id": "lab:sim/ch13-lab",
   "type": "Simulation",
   "label": {
    "ko": "그릇 바닥 찾기",
    "en": "Interactive lab ch13"
   },
   "page": "13_optimization",
   "anchor": "#lab",
