   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "MSE 손실 J(w, b) = (1/m) Σ (yᵢ − (wxᵢ + b))²를 w ← w − α ∂J/∂w, b ← b − α ∂J/∂b로 줄인다."
   }
  },
  {
