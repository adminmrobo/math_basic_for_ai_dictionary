    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "성공(1) 또는 실패(0) 한 번. 모수 p. P(X = x) = pˣ(1−p)¹⁻ˣ."
   }
  },
  {
   "id": "lab:concept/m09-binom",
   "type": "Concept",
   "label": {
    "ko": "이항 분포",
    "en": "Binomial Distribution"
   },
   "page": "09_distributions",
   "anchor": "#m09-binom",
   "level": 1,
   "status": "known",
