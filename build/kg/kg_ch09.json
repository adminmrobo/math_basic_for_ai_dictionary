   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "독립 베르누이 시행 n번 중 성공 횟수. P(X = k) = C(n,k)·pᵏ(1−p)ⁿ⁻ᵏ."
   }
  },
  {
   "id": "lab:concept/m09-pois",
   "type": "Concept",
   "label": {
    "ko": "포아송 분포",
