   "anchor": "#m09-pois",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "정해진 시간·공간에서 일어나는 사건 수. 모수 λ(평균 횟수). P(X = k) = e^−λ λᵏ / k!."
   }
  },
  {
