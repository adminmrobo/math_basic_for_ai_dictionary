  {
   "id": "lab:concept/m06-what",
   "type": "Concept",
   "label": {
    "ko": "확률이란",
    "en": "What is Probability"
   },
   "page": "06_probability",
   "anchor": "#m06-what",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "어떤 사건이 일어날 가능성을 0과 1 사이 숫자로 나타낸 것. 0은 불가능, 1은 확실."
   }
  },
  {
   "id": "lab:concept/m06-terms",
   "type": "Concept",
   "label": {
    "ko": "꼭 알아야 할 용어",
    "en": "Important Terms"
   },
   "page": "06_probability",
   "anchor": "#m06-terms",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "실험(결과가 불확실한 과정), 결과(가능한 하나), 표본공간 S(결과 전체), 사건 E(표본공간의 부분집합)."
   }
  },
  {
   "id": "lab:concept/m06-events",
   "type": "Concept",
   "label": {
    "ko": "사건의 종류",
    "en": "Types of Events"
   },
   "page": "06_probability",
   "anchor": "#m06-events",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "확실한 사건 P = 1, 불가능한 사건 P = 0, 단순 사건(결과 하나), 복합 사건(결과 여러 개)."
   }
  },
  {
   "id": "lab:concept/m06-classic",
   "type": "Concept",
   "label": {
    "ko": "고전적 확률",
    "en": "Classical Probability Formula"
   },
   "page": "06_probability",
   "anchor": "#m06-classic",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "모든 결과가 똑같이 그럴듯하면 P(E) = 유리한 경우의 수 ÷ 전체 경우의 수."
   }
  },
  {
   "id": "lab:concept/m06-complement",
   "type": "Concept",
   "label": {
    "ko": "여사건",
    "en": "Complement of an Event"
   },
   "page": "06_probability",
   "anchor": "#m06-complement",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "E가 일어나지 않는 사건 Eᶜ. P(Eᶜ) = 1 − P(E)."
   }
  },
  {
   "id": "lab:concept/m06-union",
   "type": "Concept",
   "label": {
    "ko": "덧셈 법칙 (합사건)",
    "en": "Addition Rule (Union)"
   },
   "page": "06_probability",
   "anchor": "#m06-union",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "P(A ∪ B) = P(A) + P(B) − P(A ∩ B). 겹친 부분을 한 번 뺀다."
   }
  },
  {
   "id": "lab:concept/m06-mult",
   "type": "Concept",
   "label": {
    "ko": "곱셈 법칙 (독립)",
    "en": "Multiplication Rule (Intersection)"
   },
   "page": "06_probability",
   "anchor": "#m06-mult",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "A와 B가 서로 영향을 주지 않으면(독립) P(A ∩ B) = P(A) × P(B)."
   }
  },
  {
   "id": "lab:concept/m06-cond",
   "type": "Concept",
   "label": {
    "ko": "조건부 확률 맛보기",
    "en": "Conditional Probability"
   },
   "page": "06_probability",
   "anchor": "#m06-cond",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "B가 이미 일어났을 때 A의 확률. P(A|B) = P(A ∩ B) / P(B)."
   }
  },
  {
   "id": "lab:sim/ch06-lab",
   "type": "Simulation",
   "label": {
    "ko": "주사위 실험실",
    "en": "Interactive lab ch06"
   },
   "page": "06_probability",
   "anchor": "#lab",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
   "domain": [
    "math",
    "ai"
   ],
   "match": [],
   "definition": {
    "ko": "확률은 \"한 번의 결과\"가 아니라 \"많이 되풀이했을 때의 비율\"에 대한 약속입니다. 그래서 적게 던진 결과로 확률을 판정하면 안 되고, AI가 \"93%\"라고 할 때도 그 숫자가 많은 경우에 걸쳐 맞는지(보정)를 따져야 해요."
   }
  },
  {
   "id": "lab:analogy/ch06-toon1",
   "type": "Analogy",
   "label": {
    "ko": "세 번 연속 홀수 사건",
    "en": "Cartoon 1"
   },
   "page": "06_probability",
   "anchor": "#toon1",
   "level": 1,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "family": "math-for-ai",
